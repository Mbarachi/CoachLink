# Copy to .env. Vite inlines these at BUILD time, so rebuild and
# `npx cap sync` after changing them.
#
# These are public identifiers by design — they name the project, they do not
# authorise anything. Firestore/Storage security rules and the role checks
# inside the callable functions are what actually protect data.
VITE_FIREBASE_API_KEY=AIzaSyB-6ll0whwBaJcTsz-BGN27xk9dma8jczA
VITE_FIREBASE_AUTH_DOMAIN=coachlink-22ee0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=coachlink-22ee0
VITE_FIREBASE_STORAGE_BUCKET=coachlink-22ee0.firebasestorage.app
VITE_FIREBASE_SENDER_ID=466834711042
VITE_FIREBASE_APP_ID=1:466834711042:web:c7432e537332aee7c0fd1b
VITE_FIREBASE_REGION=europe-west1

# OneSignal, for notifications that arrive when the app is closed. Public by
# design — it names the app, it does not authorise sending. The REST key that
# does live in Firebase Secret Manager, never here.
VITE_ONESIGNAL_APP_ID=
