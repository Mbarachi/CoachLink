generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ATHLETE
  PARENT
  COACH
  ADMIN
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  PASSWORD_RESET
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingMode {
  SINGLE
  PACKAGE
}

enum BookingRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  email        String   @unique
  phoneNumber  String
  passwordHash String
  role         UserRole
  profileImage String?
  isVerified   Boolean  @default(false)
  address      String?
  state        String?
  lga          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  otps            Otp[]
  coachProfile    CoachProfile?
  bookingRequests BookingRequest[]
}

model Sport {
  id       String  @id @default(uuid())
  name     String  @unique
  icon     String
  isActive Boolean @default(true)

  coaches         CoachSport[]
  bookingRequests BookingRequest[]
}

model CoachProfile {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])
  bio                String
  yearsOfExperience  Int
  sessionRate        Int
  /// Venue-based discovery per the MVP scope — a single named location
  /// (e.g. "Festival Hotel Pool"), not a structured address.
  venue              String
  area               String             @default("Amuwo Odofin")
  verificationStatus VerificationStatus @default(PENDING)
  rating             Float              @default(0)
  totalReviews       Int                @default(0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  sports          CoachSport[]
  bookingRequests BookingRequest[]

  @@index([verificationStatus, isActive])
}

model CoachSport {
  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sportId String
  sport   Sport        @relation(fields: [sportId], references: [id])

  @@id([coachId, sportId])
}

model Otp {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  email     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  consumed  Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([email, purpose])
}

model BookingRequest {
  id        String       @id @default(uuid())
  /// The account that booked — an ATHLETE for themselves, or a PARENT for a child.
  athleteId String
  athlete   User         @relation(fields: [athleteId], references: [id])
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id])
  sportId   String
  sport     Sport        @relation(fields: [sportId], references: [id])

  mode       BookingMode
  /// Package only — how many weeks the recurrence runs for.
  weeks      Int?
  /// Package only — 0 = Sunday. Display metadata; `sessions` is authoritative.
  daysOfWeek Int[]
  /// Coach-local start time as "HH:mm" on a 24-hour clock.
  startTime  String

  /// Snapshotted at request time: a coach raising their rate later must not
  /// change what an already-submitted request costs.
  sessionRate  Int
  sessionCount Int
  totalAmount  Int

  notes     String?
  /// Set when a PARENT books on behalf of a child; null for athlete bookings.
  childName String?
  childAge  Int?

  status      BookingRequestStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  sessions BookingRequestSession[]

  @@index([coachId, status])
  @@index([athleteId, status])
}

/// One concrete session. The recurrence is expanded at request time rather than
/// on acceptance, so the coach sees the exact dates they are committing to and
/// conflicts can be detected before they accept.
model BookingRequestSession {
  id          String         @id @default(uuid())
  requestId   String
  request     BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scheduledAt DateTime

  @@index([requestId])
  @@index([scheduledAt])
}
