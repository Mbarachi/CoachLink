# Copy to .env and fill in values

PORT=3000

POSTGRES_USER=coachlink
POSTGRES_PASSWORD=coachlink
POSTGRES_DB=coachlink
DATABASE_URL=postgresql://coachlink:coachlink@localhost:5432/coachlink

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# OTP delivery — leave RESEND_API_KEY blank to fall back to console-logging codes (dev only).
# Get a key at https://resend.com. Until a custom domain is verified there, Resend's
# sandbox sender (onboarding@resend.dev) can only deliver to your own account email.
RESEND_API_KEY=
EMAIL_FROM=CoachLink <onboarding@resend.dev>
